# ==============================================================================
# ANIME TRACKER - ZENTRALE KONFIGURATION & SECRETS
# ==============================================================================
# Kopiere diese Datei nach `.env` im Projekt-Root:
#   cp .env.example .env
#
# Alle Komponenten (Docker Compose, FastAPI-Backend, Next.js Frontend)
# lesen ihre Einstellungen zentral aus dieser Datei.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATENBANK (PostgreSQL & Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_USER=anime
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=anime
POSTGRES_PORT=5432

# SQLAlchemy Async Connection String für das FastAPI-Backend & Alembic Migrations
DATABASE_URL=postgresql+asyncpg://anime:securepassword@localhost:5432/anime

# ------------------------------------------------------------------------------
# 2. BACKEND API (FastAPI)
# ------------------------------------------------------------------------------
APP_NAME="Anime Tracker API"
ENVIRONMENT=development

# Geheimer Schlüssel für Session-Cookies (in Produktion mind. 32 Zeichen lang!)
SESSION_SECRET=change-me-to-a-very-secure-random-secret-key-32-chars

# Erlaubte Frontend-Origin für CORS & Cookies
FRONTEND_URL=http://localhost:3000

# AniList GraphQL Endpunkt
ANILIST_API_URL=https://graphql.anilist.co

# OpenRouter KI-Integration (für Anime Ask & KI-Empfehlungen)
# Trage hier deinen OpenRouter API-Schlüssel ein (z. B. sk-or-v1-...)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# ------------------------------------------------------------------------------
# 3. FRONTEND (Next.js)
# ------------------------------------------------------------------------------
# Öffentliche Backend-URL für Browser-Requests
NEXT_PUBLIC_API_URL=http://localhost:8000
